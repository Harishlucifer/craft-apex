{
  "name": "craft-apex",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:employee": "turbo run dev --filter=@craft-apex/employee-portal",
    "build": "turbo run build",
    "build:employee": "turbo run build --filter=@craft-apex/employee-portal",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=18"
  }
}
