# Base URL of the lending API (legacy REACT_APP_API_URL)
VITE_API_ENDPOINT=
# Platform header sent on every request. Backend maps CUSTOMER_PORTAL -> UserTypeCustomer
# (alpha-api: utility.ValidatePlatform), which auto-scopes list endpoints to the
# signed-in customer's own applications. Do not change without a backend change.
VITE_PLATFORM=CUSTOMER_PORTAL
# X-Tenant-Domain header. Leave blank to use the browser origin.
VITE_TENANT_DOMAIN=
VITE_BRAND_NAME=Craft Apex
