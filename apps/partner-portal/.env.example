# Base URL of the lending API (legacy REACT_APP_API_URL)
VITE_API_ENDPOINT=
# Platform header sent on every request. Backend maps PARTNER_PORTAL -> UserTypeChannel
# (alpha-api: utility.ValidatePlatform). Do not change without a backend change.
VITE_PLATFORM=PARTNER_PORTAL
# X-Tenant-Domain header. Leave blank to use the browser origin
# (window.location.origin). Set to the tenant's real domain to test a
# multi-tenant backend locally, e.g. https://apx-multi-tenant-uat.lendingstack.in
VITE_TENANT_DOMAIN=
VITE_BRAND_NAME=Craft Apex Partner
