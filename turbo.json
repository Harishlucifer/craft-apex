{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "VITE_API_ENDPOINT",
    "VITE_PLATFORM",
    "VITE_TENANT_DOMAIN",
    "VITE_BRAND_NAME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "dev": { "cache": false, "persistent": true }
  }
}
